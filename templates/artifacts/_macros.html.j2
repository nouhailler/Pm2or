{% macro value(label, code) -%}<h3>{{ label }}</h3><p class="{{ '' if artifact_data.get(code) else 'empty' }}">{{ artifact_data.get(code) or 'Non renseigné.' }}</p>{%- endmacro %}
{% macro records(title, items) -%}<h2>{{ title }}</h2>{% if items %}<table><thead><tr><th>Code</th><th>Élément</th><th>Statut</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.code | default('—') }}</td><td>{{ item.title | default(item.name) | default('—') }}</td><td>{{ item.status | default('—') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="empty">Aucun élément enregistré.</p>{% endif %}{%- endmacro %}
