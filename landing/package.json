{
  "name": "pm2-desktop-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Site de présentation statique et installable de PM² Desktop",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dev",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && node scripts/serve.mjs",
    "check:html": "html-validate dist/index.html dist/offline.html dist/404.html",
    "test": "npm run build && npm run check:html && node --test tests/static.test.mjs tests/browser.test.mjs",
    "og-image": "node scripts/og-image.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "html-validate": "^11.18.0",
    "playwright": "^1.64.1"
  }
}
